{
  "name": "@sikessem/ui",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4"
  },
  "packageManager": "bun@1.4.2",
  "publishConfig": {
    "access": "public"
  },
  "bugs": "https://github.com/sikessem/ui/issues",
  "homepage": "https://sikessem.github.io/packages/ui",
  "author": {
    "name": "SIGUI Kessé Emmanuel",
    "email": "contact@sigui.ci",
    "url": "https://sigui.ci"
  },
  "description": "TailwindCSS components and utilities to design faster.",
  "keywords": [
    "sikessem",
    "tailwindcss",
    "plugin",
    "utilities",
    "componants",
    "css",
    "typescript"
  ],
  "main": "./dist/index.js",
  "types": "./plugin/types/index.d.ts",
  "scripts": {
    "build": "bun -C packages/ui build",
    "check": "biome ci .",
    "check.format": "biome format .",
    "check.lint": "biome check .",
    "debug": "bun check && bun test",
    "fix": "bun lint && bun format",
    "format": "biome format --write .",
    "inspect": "node --inspect-brk ./node_modules/vite/bin/vite.js --force",
    "lint": "biome check --write .",
    "test": "vitest run",
    "test.ui": "vitest --ui",
    "test.cov": "vitest run --coverage",
    "watch": "tsm scripts/build.ts --watch"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@sikessem/ui": "workspace:*",
    "@tailwindcss/nesting": "0.0.0-insiders.565cd3e",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@vitest/coverage-istanbul": "^5.0.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "plugwind.js": "^0.9.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "workspaces": [
    "packages/*"
  ]
}
